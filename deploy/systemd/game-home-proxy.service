[Unit]
Description=Game Auto Framework Home Residential Proxy (sing-box)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/sing-box run -c /etc/game-auto-framework/home-proxy-singbox.json
Restart=always
RestartSec=3s
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
